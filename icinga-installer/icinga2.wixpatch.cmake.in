<CPackWiXPatch>
  <CPackWiXFragment Id="#PRODUCT">
    <Property Id="ALLUSERS">1</Property>
    <Property Id="MSIRESTARTMANAGERCONTROL">Disable</Property>

    <!--
      Side-by-side instances. Instance 1 is the product as it has always been shipped and needs no
      transform; instances 2..N are instance transforms embedded into this very package and are
      selected either through IcingaInstanceDlg or on the command line:

        msiexec /i Icinga2.msi TRANSFORMS=:Instance2 MSINEWINSTANCE=1

      The instances and their defaults are generated by cmake/Icinga2MsiInstances.cmake.
    -->
    <Property Id="INSTANCEID" Value="Instance1" />
@ICINGA2_WIX_MULTI_INSTANCE_PROPERTY@@ICINGA2_WIX_INSTANCE_TRANSFORMS@
    <!-- Optional overrides for the data directory and the service name, e.g.
         msiexec /i Icinga2.msi ICINGA_DATA_DIR="D:\IcingaData" ICINGA_SERVICE_NAME=icinga2-b -->
    <Property Id="ICINGA_DATA_DIR" Secure="yes" />
    <Property Id="ICINGA_SERVICE_NAME" Secure="yes" />

    <!-- Scratch directory for the data-directory chooser: resolved to the default at
         costing time, edited by the PathEdit/BrowseDlg pair on the options page and
         copied into ICINGA_DATA_DIR when leaving the page. -->
    <Property Id="ICINGA_DATA_DIR_INDIRECT" Value="ICINGA_BROWSE_DIR" />
    <DirectoryRef Id="TARGETDIR">
      <Directory Id="CommonAppDataFolder">
        <Directory Id="ICINGA_BROWSE_DIR" Name="icinga2" />
      </Directory>
    </DirectoryRef>

    <!--
      What each instance recorded about itself when it was installed. These searches are how the
      picker knows which instances exist, and they restore the settings of an instance that is being
      upgraded - a major upgrade installs a fresh product, so nothing else would carry them over.
    -->
@ICINGA2_WIX_INSTANCE_SEARCHES@
    <!-- Installations made by packages from before instance support persisted their settings in a
         single flat key. Keep reading it so that they upgrade without losing their configuration. -->
    <Property Id="ICINGA_LEGACY_SERVICE">
      <RegistrySearch Id="IcingaLegacyService" Root="HKLM" Key="SOFTWARE\Icinga GmbH\Icinga 2" Name="ServiceName" Type="raw" />
    </Property>
    <Property Id="ICINGA_LEGACY_DATADIR">
      <RegistrySearch Id="IcingaLegacyDataDir" Root="HKLM" Key="SOFTWARE\Icinga GmbH\Icinga 2" Name="DataDir" Type="raw" />
    </Property>

    <!-- An instance 1 installed by such a package has no marker key, but the product is there.
         Like every other action that reads a marker value, this has to run after AppSearch (400),
         which is what populates the registry searches - not after FindRelatedProducts (200). -->
    <SetProperty Id="ICINGA_INSTANCE_1_INFO" Action="IcingaInfo1Legacy" Sequence="ui"
        Value="installed" After="AppSearch"><![CDATA[NOT ICINGA_INSTANCE_1_VERSION AND (Installed OR WIX_UPGRADE_DETECTED OR WIX_DOWNGRADE_DETECTED)]]></SetProperty>
    <SetProperty Id="ICINGA_INSTANCE_INSTALLED" Action="IcingaInstalled1Legacy" Sequence="both"
        Value="1" After="AppSearch"><![CDATA[INSTANCEID = "Instance1" AND (Installed OR WIX_UPGRADE_DETECTED OR WIX_DOWNGRADE_DETECTED)]]></SetProperty>

    <!-- Derived state for the instance overview page: whether any instance is installed at all
         (ICINGA_ANY_INSTANCE - if not, the page is skipped and setup goes straight to a fresh
         installation) and which instance a new installation would get (ICINGA_NEXT_FREE_INSTANCE
         and its service name - unset when every instance is taken). -->
@ICINGA2_WIX_INSTANCE_STATE@
    <!--
      Value resolution, in two waves and in both sequences so that silent installations end up with
      exactly the same values as interactive ones:
        1. After AppSearch, restore what the instance recorded, unless it was passed on the command line.
        2. Before CostFinalize, fill in the build time defaults. Directory properties (INSTALL_ROOT,
           ICINGA_BROWSE_DIR, PROGRAM_MENU_FOLDER) only redirect their directory tree when they are
           set before costing.
      The waves are ordered by their sequence anchors; within a wave the conditions are written so
      that the relative order of the individual actions does not matter.
    -->
@ICINGA2_WIX_INSTANCE_DEFAULTS@    <SetProperty Id="ICINGA_SERVICE_NAME" Action="IcingaRestoreLegacyService" Sequence="both"
        Value="[ICINGA_LEGACY_SERVICE]" After="AppSearch"><![CDATA[INSTANCEID = "Instance1" AND NOT ICINGA_SERVICE_NAME AND NOT ICINGA_INSTANCE_1_SERVICE AND ICINGA_LEGACY_SERVICE]]></SetProperty>
    <SetProperty Id="ICINGA_DATA_DIR" Action="IcingaRestoreLegacyDataDir" Sequence="both"
        Value="[ICINGA_LEGACY_DATADIR]" After="AppSearch"><![CDATA[INSTANCEID = "Instance1" AND NOT ICINGA_DATA_DIR AND NOT ICINGA_INSTANCE_1_DATADIR AND ICINGA_LEGACY_DATADIR]]></SetProperty>

    <PropertyRef Id="WIX_IS_NETFRAMEWORK_46_OR_LATER_INSTALLED" />
    <Condition Message='This application requires .NET Framework 4.6 or higher. Please install the .NET Framework then run this installer again.'>
      <![CDATA[Installed OR WIX_IS_NETFRAMEWORK_46_OR_LATER_INSTALLED]]>
    </Condition>

    <CustomAction Id="XtraUpgradeNSIS" BinaryKey="icinga2_installer" ExeCommand="upgrade-nsis" Execute="deferred" Impersonate="no" />
    <!-- The trailing space inside the quotes keeps a trailing backslash in the property
         value from escaping the closing quote; the installer trims it again. -->
    <CustomAction Id="XtraInstall" FileKey="CM_FP_sbin.icinga2_installer.exe" ExeCommand='install "[ICINGA_DATA_DIR] " "[ICINGA_SERVICE_NAME] " "[INSTANCEID] " "[ICINGA_EVENTLOG_SOURCE] "' Execute="deferred" Impersonate="no" />
    <CustomAction Id="XtraUninstall" FileKey="CM_FP_sbin.icinga2_installer.exe" ExeCommand='uninstall "[INSTANCEID] "' Execute="deferred" Impersonate="no" />
    <!--
      An instance transform only regenerates the GUID of components authored with
      MultiInstance="yes" (WiX 3 Binder.CreateInstanceTransforms). CPack generates the components
      that carry the payload and does not mark them, so all instances share their GUIDs while
      installing into different directories. Windows Installer therefore still sees clients for
      those components when one instance is removed, and leaves that instance's files behind.

      XtraCleanup removes the installation directory of the instance being uninstalled, but only if
      no other instance claims it. It runs from the Binary table because the installed copy of the
      executable is gone by then. The proper fix would be to get MultiInstance="yes" onto the
      CPack-generated components, which the patch cannot reach today.
    -->
    <CustomAction Id="XtraCleanup" BinaryKey="icinga2_installer" ExeCommand='cleanup "[INSTANCEID] " "[INSTALL_ROOT] " "[PROGRAM_MENU_FOLDER] "' Execute="deferred" Impersonate="no" Return="ignore" />

    <Binary Id="icinga2_installer" SourceFile="$<TARGET_FILE:icinga-installer>" />

    <InstallExecuteSequence>
      <Custom Action="XtraUpgradeNSIS" After="InstallInitialize"><![CDATA[$CM_CP_sbin.icinga2_installer.exe>2 AND NOT SUPPRESS_XTRA AND INSTANCEID = "Instance1"]]></Custom>
      <Custom Action="XtraInstall" Before="InstallFinalize">$CM_CP_sbin.icinga2_installer.exe&gt;2 AND NOT SUPPRESS_XTRA</Custom>
      <!-- Before the instance's registry key and instance.ini are removed, which is where the
           uninstall reads the name of the service it has to remove, and before RemoveFiles, which
           would take icinga2.exe away from it. -->
      <Custom Action="XtraUninstall" Before="RemoveRegistryValues">$CM_CP_sbin.icinga2_installer.exe=2 AND NOT SUPPRESS_XTRA</Custom>
      <Custom Action="XtraCleanup" After="RemoveFiles"><![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND NOT SUPPRESS_XTRA]]></Custom>
    </InstallExecuteSequence>

    <!--
      Per-instance registry state. Component/@Guid="*" derives the GUID from the resolved key path,
      so these literal per-instance keys are the only components in the package that are unique per
      instance - and therefore the only ones Windows Installer removes when a single instance is
      uninstalled. That is also why the removal of instance.ini is authored here.

      The event log entry lets the Event Viewer find the message definitions of eventprovider.dll.
      See also: https://docs.microsoft.com/en-us/windows/win32/eventlog/reporting-an-event
    -->
    <FeatureRef Id="ProductFeature" IgnoreParent="yes">
@ICINGA2_WIX_INSTANCE_COMPONENTS@    </FeatureRef>

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Run Icinga 2 setup wizard" />

    <Property Id="WixShellExecTarget" Value="[#CM_FP_sbin.Icinga2SetupAgent.exe]" />
    <CustomAction Id="LaunchIcinga2Wizard"
        BinaryKey="WixCA"
        DllEntry="WixShellExec"
        Impersonate="no" />

    <!--
      A transform can only be applied while the database is being opened, so the instance cannot be
      changed within a running session. IcingaInstanceDlg therefore restarts the installer for every
      instance but the first one. MSINEWINSTANCE must only be passed when the instance does not
      exist yet; without it the restarted session upgrades or maintains the existing instance.
    -->
    <SetProperty Id="ICINGA_MSIEXEC" Action="IcingaMsiExecPath" Sequence="ui"
        Value="[SystemFolder]msiexec.exe" After="CostFinalize">1</SetProperty>
    <CustomAction Id="IcingaRelaunch" Property="ICINGA_MSIEXEC" Execute="immediate" Return="asyncNoWait"
        ExeCommand='/i "[OriginalDatabase]" TRANSFORMS=":[ICINGA_RELAUNCH_INSTANCE]" [ICINGA_RELAUNCH_NEW]' />

    <InstallUISequence>
      <!--
        Scheduled relative to a standard action on purpose, never relative to one of the WixUI
        dialogs: those are authored as Overridable, WixUI_Advanced declares a competing
        Show row for WelcomeDlg, and an anchor like Before="WelcomeDlg" makes light resolve the
        reference against that fragment - dragging WixUI_Advanced and its InstallScopeDlg into a
        package that uses WixUI_InstallDir.

        MigrateFeatureStates is 1200, while WelcomeDlg, ResumeDlg and MaintenanceWelcomeDlg are all
        scheduled before ProgressDlg, which in turn sits just below ExecuteAction at 1300. The picker
        therefore runs ahead of all three, and AppSearch and FindRelatedProducts have long provided
        the state it displays.

        The overview only appears when at least one instance is installed (ICINGA_ANY_INSTANCE);
        on a clean machine there is nothing to manage, so setup proceeds directly to a fresh
        installation of the default instance.

        A session that already carries a transform skips the overview, which is what keeps the
        restart from looping. Maintenance started from Programs and Features (Preselected) goes
        straight to the instance it belongs to.
      -->
      <Show Dialog="IcingaInstanceDlg" After="MigrateFeatureStates"><![CDATA[ICINGA_MULTI_INSTANCE AND ICINGA_ANY_INSTANCE AND INSTANCEID = "Instance1" AND NOT PATCH AND NOT RESUME AND NOT Preselected]]></Show>
    </InstallUISequence>

    <UI>
        <Publish Dialog="ExitDialog"
            Control="Finish"
            Event="DoAction"
            Value="LaunchIcinga2Wizard">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>

        <!-- Overview of the installed instances, shown before anything else - but only when
             something is installed; a clean machine goes straight to the normal installation
             flow. Every installed instance gets a row with its recorded state and a Manage
             button that leads to its maintenance (repair, upgrade or remove), while "Install
             new instance" starts the installation of the first free instance. Layout mirrors
             the stock WixUI dialogs. -->
        <Dialog Id="IcingaInstanceDlg" Width="370" Height="270" Title="[ProductName] Setup">
            <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                Text="{\WixUI_Font_Title}Installed Instances" />
            <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                Text="Manage an installed Icinga 2 instance or install a new one." />
            <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                Text="WixUI_Bmp_Banner" />
            <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

@ICINGA2_WIX_INSTANCE_ROWS@@ICINGA2_WIX_INSTANCE_NOTE@
            <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
            <Control Id="NewInstance" Type="PushButton" X="20" Y="243" Width="110" Height="17" Default="yes" Text="Install new instance">
                <Condition Action="hide"><![CDATA[NOT ICINGA_NEXT_FREE_INSTANCE]]></Condition>
                <Condition Action="show"><![CDATA[ICINGA_NEXT_FREE_INSTANCE]]></Condition>
                <!-- The first free instance may be instance 1 itself, for example when only
                     instance 2 is installed. This session already is instance 1 (it runs without
                     a transform), so it simply continues as a fresh installation. Every other
                     instance needs its transform and therefore a restart, with MSINEWINSTANCE
                     because the instance does not exist yet.

                     Ending the session is what makes room for the restarted one. Windows Installer
                     treats this like a cancellation and shows its "setup was interrupted" dialog for
                     the session that is being left behind, which is what IcingaRestartDlg announces. -->
                <Publish Event="EndDialog" Value="Return" Order="1"><![CDATA[ICINGA_NEXT_FREE_INSTANCE = "Instance1"]]></Publish>
                <Publish Property="ICINGA_RELAUNCH_INSTANCE" Value="[ICINGA_NEXT_FREE_INSTANCE]" Order="2"><![CDATA[ICINGA_NEXT_FREE_INSTANCE <> "Instance1"]]></Publish>
                <Publish Property="ICINGA_RELAUNCH_NEW" Value="MSINEWINSTANCE=1" Order="3"><![CDATA[ICINGA_NEXT_FREE_INSTANCE <> "Instance1"]]></Publish>
                <Publish Event="SpawnDialog" Value="IcingaRestartDlg" Order="4"><![CDATA[ICINGA_NEXT_FREE_INSTANCE <> "Instance1"]]></Publish>
                <Publish Event="DoAction" Value="IcingaRelaunch" Order="5"><![CDATA[ICINGA_NEXT_FREE_INSTANCE <> "Instance1"]]></Publish>
                <Publish Event="EndDialog" Value="Exit" Order="6"><![CDATA[ICINGA_NEXT_FREE_INSTANCE <> "Instance1"]]></Publish>
            </Control>
            <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
            </Control>
        </Dialog>

        <!-- Extra page between InstallDirDlg and VerifyReadyDlg for the instance name
             and the data directory (fresh installs only). Together with the stock
             InstallDirDlg, which covers the installation directory, these are the
             three settings the installer offers. Layout mirrors the stock WixUI
             dialogs (370x270, banner, button row). -->
        <Dialog Id="IcingaOptionsDlg" Width="370" Height="270" Title="[ProductName] Setup">
            <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                Text="{\WixUI_Font_Title}Instance Name and Data Directory" />
            <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                Text="Optionally customize this Icinga 2 installation." />
            <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                Text="WixUI_Bmp_Banner" />
            <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

            <Control Id="ServiceNameLabel" Type="Text" X="20" Y="60" Width="330" Height="10" NoPrefix="yes"
                Text="Instance name (used as the name of the Windows service):" />
            <Control Id="ServiceNameEdit" Type="Edit" X="20" Y="72" Width="330" Height="17"
                Property="ICINGA_SERVICE_NAME" />

            <Control Id="DataDirLabel" Type="Text" X="20" Y="100" Width="330" Height="10" NoPrefix="yes"
                Text="Data directory (configuration, certificates, state and logs):" />
            <Control Id="DataDirEdit" Type="PathEdit" X="20" Y="112" Width="250" Height="17"
                Property="ICINGA_DATA_DIR_INDIRECT" Indirect="yes" />
            <Control Id="DataDirBrowse" Type="PushButton" X="276" Y="111" Width="74" Height="19" Text="B&amp;rowse...">
                <Publish Property="_BrowseProperty" Value="[ICINGA_DATA_DIR_INDIRECT]" Order="1">1</Publish>
                <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
            </Control>

            <Control Id="DefaultsNote" Type="Text" X="20" Y="146" Width="330" Height="40" NoPrefix="yes"
                Text="The fields are pre-filled with the defaults. On upgrades, previously configured values are kept automatically." />

            <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
            <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
                <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
            </Control>
            <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
                <Publish Property="ICINGA_DATA_DIR" Value="[ICINGA_BROWSE_DIR]" Order="1">1</Publish>
                <Publish Event="SpawnDialog" Value="IcingaConflictDlg" Order="2"><![CDATA[@ICINGA2_WIX_INSTANCE_CONFLICT@]]></Publish>
                <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="3"><![CDATA[NOT (@ICINGA2_WIX_INSTANCE_CONFLICT@)]]></Publish>
            </Control>
            <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
            </Control>
        </Dialog>

        <Dialog Id="IcingaRestartDlg" Width="260" Height="95" Title="[ProductName] Setup" NoMinimize="yes">
            <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" ToolTip="Information" FixedSize="yes" IconSize="32"
                Text="WixUI_Ico_Info" />
            <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="42" NoPrefix="yes"
                Text="Setup will now restart for the selected instance. This window closes and reports that it was interrupted; the new window continues the installation." />
            <Control Id="OK" Type="PushButton" X="97" Y="67" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
                <Publish Event="EndDialog" Value="Return">1</Publish>
            </Control>
        </Dialog>

        <!-- Two instances sharing a service name or a data directory would corrupt each other. -->
        <Dialog Id="IcingaConflictDlg" Width="260" Height="85" Title="[ProductName] Setup" NoMinimize="yes">
            <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" ToolTip="Conflict" FixedSize="yes" IconSize="32"
                Text="WixUI_Ico_Exclam" />
            <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="32" NoPrefix="yes"
                Text="The instance name or the data directory is already used by another Icinga 2 instance. Please choose different values." />
            <Control Id="OK" Type="PushButton" X="97" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
                <Publish Event="EndDialog" Value="Return">1</Publish>
            </Control>
        </Dialog>

        <!-- Reroute the WixUI_InstallDir flow through the options page. The extension's
             own ControlEvent rows use Order 1-4; all rows whose condition is true
             fire in Order and the last NewDialog wins, so Order 10 overrides them.
             The path-validation part of the condition keeps WixUIValidatePath /
             InvalidDirDlg working; the page is skipped whenever the selected instance is
             already installed, no matter whether Windows Installer classifies that as
             maintenance (Installed) or as a major upgrade. -->
        <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="IcingaOptionsDlg" Order="10">
            <![CDATA[NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT ICINGA_INSTANCE_INSTALLED AND (WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1")]]>
        </Publish>
        <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="IcingaOptionsDlg" Order="10">
            <![CDATA[NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT ICINGA_INSTANCE_INSTALLED]]>
        </Publish>
    </UI>
  </CPackWiXFragment>
</CPackWiXPatch>
